    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "Jaehyeon's Portfolio",
  "params": {
    "description": "Jaehyeon Portfolio, Welcome to my Website",
    "author": "Jaehyeon",
    "keywords": [
      "Jaehyeon",
