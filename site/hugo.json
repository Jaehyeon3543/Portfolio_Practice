{
  "baseURL": "https://jaehyeon3543.github.io/Portfolio_Practice/",
  "title": "Jaehyeon's Portfolio",
  "languageCode": "ko",
  "defaultContentLanguage": "ko",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "params": {
    "heroTitleLine1": "Jaehyeon's",
    "heroTitleLine2": "Portfolio",
    "description": "A portfolio website for Jaehyeon, showcasing projects and experiences.",
    "author": "Jaehyeon",
    "keywords": [
      "Jaehyeon",
      "Portfolio"
    ],
    "social": {
      "github": "https://github.com/Jaehyeon3543",
      "email": "jaehyeonlee.dev@gmail.com"
    }, 
    "copyright": {
      "name": "Jaehyeon",
      "owner" : "Jaehyeon"
    },
    "avatar": {
      "home": {
        "url": "claude_coffee.png"
      }
    }
  },
  "Menus": {
      "main": [
        {
          "name": "About",
          "url": "#about",
          "weight" : 1
        },
        {
          "name": "Projects",
          "url": "#projects",
          "weight" : 2
        },
        {
          "name": "Experience",
          "url": "#experience",
          "weight" : 3
        },
        {
          "name": "Blog",
          "url": "#blog",
          "weight" : 4
        },
        {
          "name": "Contact",
          "url": "#contact",
          "weight" : 5
        }
      ]
    }
}
